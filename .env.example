# Copy to .env.local. Never commit real keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Production build-time SEO (use your REAL public homepage address, trailing slash optional).
# Set via deployment environment or CI. Never set an example domain in production.
# SITE_URL=https://your-real-math-domain.kr/

# Search Console / Naver Search Advisor HTML meta verification values (public tokens).
# GOOGLE_SITE_VERIFICATION=your-google-verification-token
# NAVER_SITE_VERIFICATION=your-naver-verification-token
